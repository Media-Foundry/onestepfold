{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onestepfold.invalid/schema/gt_schema_v1.json",
  "title": "OneStepFold multi-chain structure instance GT v1",
  "description": "Structure-first, all-heavy-atom experimental GT record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "pdb_id",
    "coordinate_view",
    "assembly_id",
    "model_id",
    "assembly_definition_source",
    "atom_vocabulary",
    "chains",
    "chain_pair_interfaces",
    "experimental",
    "hidden_context",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "gt_schema_v1" },
    "sample_id": { "type": "string", "minLength": 1 },
    "pdb_id": { "type": "string", "pattern": "^[0-9a-z]{4}$" },
    "coordinate_view": {
      "type": "string",
      "enum": ["asymmetric_unit", "biological_assembly"]
    },
    "assembly_id": { "type": ["string", "null"] },
    "model_id": { "type": "integer", "minimum": 1 },
    "assembly_definition_source": {
      "type": "string",
      "enum": ["author_determined", "software_determined", "unspecified", "not_applicable"]
    },
    "atom_vocabulary": { "const": "atom37_heavy_v1" },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chain" }
    },
    "chain_pair_interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "experimental": { "$ref": "#/$defs/experimental" },
    "hidden_context": { "$ref": "#/$defs/hidden_context" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "sifts_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pdb": { "type": "string" },
        "chain": { "type": "string" },
        "sp_primary": { "type": "string" },
        "res_beg": { "type": ["string", "null"] },
        "res_end": { "type": ["string", "null"] },
        "pdb_beg": { "type": ["string", "null"] },
        "pdb_end": { "type": ["string", "null"] },
        "sp_beg": { "type": ["string", "null"] },
        "sp_end": { "type": ["string", "null"] }
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_seq_id",
        "auth_seq_id",
        "insertion_code",
        "comp_id",
        "aatype",
        "is_modified_residue",
        "residue_mask",
        "atom_positions",
        "atom_mask",
        "selected_altloc",
        "altloc_fraction"
      ],
      "properties": {
        "label_seq_id": { "type": "integer", "minimum": 1 },
        "auth_seq_id": { "type": ["string", "null"] },
        "insertion_code": { "type": ["string", "null"] },
        "comp_id": { "type": "string", "minLength": 1 },
        "aatype": { "type": "string", "minLength": 1 },
        "is_modified_residue": { "type": "boolean" },
        "residue_mask": { "type": "boolean" },
        "atom_positions": {
          "type": "array",
          "minItems": 37,
          "maxItems": 37,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        },
        "atom_mask": {
          "type": "array",
          "minItems": 37,
          "maxItems": 37,
          "items": { "type": "boolean" }
        },
        "selected_altloc": { "type": ["string", "null"] },
        "altloc_fraction": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly_chain_instance_id",
        "chain_index",
        "source_label_asym_id",
        "auth_asym_ids",
        "entity_id",
        "entity_instance_index",
        "homomer_group_id",
        "operator_path",
        "sequence",
        "sequence_length",
        "residues",
        "sifts_provenance"
      ],
      "properties": {
        "assembly_chain_instance_id": { "type": "string", "minLength": 1 },
        "chain_index": { "type": "integer", "minimum": 0 },
        "source_label_asym_id": { "type": "string", "minLength": 1 },
        "auth_asym_ids": { "type": "array", "items": { "type": "string" } },
        "entity_id": { "type": "string", "minLength": 1 },
        "entity_instance_index": { "type": "integer", "minimum": 0 },
        "homomer_group_id": { "type": "string", "minLength": 1 },
        "operator_path": { "type": "array", "items": { "type": "string" } },
        "sequence": { "type": "string", "minLength": 1 },
        "sequence_length": { "type": "integer", "minimum": 1 },
        "residues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/residue" } },
        "sifts_provenance": { "type": "array", "items": { "$ref": "#/$defs/sifts_row" } }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_i",
        "chain_j",
        "min_heavy_atom_distance_angstrom",
        "heavy_atom_contact_count",
        "interface_residue_indices_i",
        "interface_residue_indices_j"
      ],
      "properties": {
        "chain_i": { "type": "integer", "minimum": 0 },
        "chain_j": { "type": "integer", "minimum": 0 },
        "min_heavy_atom_distance_angstrom": { "type": ["number", "null"], "minimum": 0.0 },
        "heavy_atom_contact_count": { "type": "integer", "minimum": 0 },
        "interface_residue_indices_i": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "interface_residue_indices_j": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "resolution_high_angstrom", "model_id", "model_count"],
      "properties": {
        "methods": { "type": "array", "items": { "type": "string" } },
        "resolution_high_angstrom": { "type": ["number", "null"], "minimum": 0.0 },
        "model_id": { "type": "integer", "minimum": 1 },
        "model_count": { "type": "integer", "minimum": 1 },
        "r_work": { "type": ["number", "null"], "minimum": 0.0 },
        "r_free": { "type": ["number", "null"], "minimum": 0.0 }
      }
    },
    "hidden_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonprotein_atom_count",
        "nucleic_acid_atom_count",
        "ligand_atom_count",
        "ligand_bridges_protein_chains"
      ],
      "properties": {
        "nonprotein_atom_count": { "type": "integer", "minimum": 0 },
        "nucleic_acid_atom_count": { "type": "integer", "minimum": 0 },
        "ligand_atom_count": { "type": "integer", "minimum": 0 },
        "ligand_bridges_protein_chains": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mmcif_sha256", "source_mmcif_filename", "parser_version", "protocol_version"],
      "properties": {
        "source_mmcif_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_mmcif_filename": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "protocol_version": { "const": "gt_protocol_v1" }
      }
    }
  }
}
